# Caddy gets and renews the HTTPS certificate for WIKID_DOMAIN automatically
# (Let's Encrypt), redirects HTTP to HTTPS, and passes everything to nginx.
(no_server_headers) {
	# Don't advertise the software behind the site
	header {
		-Server
		-Via
		defer
	}
}

{$WIKID_DOMAIN} {
	import no_server_headers
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		# Don't let other sites put Wikid in a frame (clickjacking); Wikid never frames itself
		X-Frame-Options "DENY"
		# Use the declared Content-Type; don't let browsers guess (e.g. treat an upload as a script)
		X-Content-Type-Options "nosniff"
		# Links to other sites only reveal the origin, not the full page address
		Referrer-Policy "strict-origin-when-cross-origin"
		# Turn off device features Wikid never uses (clipboard and fullscreen stay available)
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=()"
		# What the page may load. Scripts only from Wikid itself (plus WebAssembly
		# and blob: workers for the Gaussian splat viewer). Inline styles are
		# needed by the editor and emoji picker. Images may come from any HTTPS
		# site (link previews, pasted image URLs). draw.io is the only frame.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss://{$WIKID_DOMAIN} data: blob:; worker-src 'self' blob:; media-src 'self' data: blob:; frame-src https://embed.diagrams.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	reverse_proxy web:80
}

# Explicit HTTP-to-HTTPS redirect, so its headers can be controlled too
http://{$WIKID_DOMAIN} {
	import no_server_headers
	redir https://{host}{uri} 308
}
