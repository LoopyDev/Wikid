# Server settings for a production install. Copy to .env on the server:
#   cp .env.production.example .env
# Fill in every value, then: docker compose up -d --build
# See docs/deployment.md.

COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The domain people use, with its DNS A record pointing at this server
WIKID_DOMAIN=wiki.example.com

# Your login. Used once, when the database is first created; change the
# password in the app afterwards (it won't update from here).
WIKID_ADMIN_EMAIL=you@example.com
WIKID_ADMIN_PASSWORD=

# Generate each with: openssl rand -hex 32
# (hex only: these go inside connection URLs). Postgres reads its password
# only when the database is first created, so set it before the first start.
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
COMPLIANCE_MINIO_ROOT_PASSWORD=

# Optional: enables the AI features
ANTHROPIC_API_KEY=

# Optional: session and collab secrets are generated on first start if unset
# SESSION_SECRET=
# COLLAB_JWT_SECRET=
# COLLAB_API_SECRET=
