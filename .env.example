# Docker Compose settings. The API, collab server and web app each have their own
# .env (see api/.env.example, collab/.env.example and web/.env.example).

# Dev mode: also load docker-compose.dev.yml, which publishes the databases and MinIO
# on localhost so the app can run from source. Remove for a Docker-only install.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# MinIO credentials and bucket (the API's S3_* settings must match)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
COMPLIANCE_MINIO_ROOT_USER=minioadmin
COMPLIANCE_MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=wikid
S3_REGION=us-east-1

# imgproxy (dev only, optional; generate with: openssl rand -hex 64)
IMGPROXY_KEY=
IMGPROXY_SALT=

# Docker-only install settings: see "Quick start (Docker)" in the README
# WIKID_PORT=8088
# WIKID_PUBLIC_URL=http://localhost:8088
# SESSION_COOKIE_SECURE=false
# ANTHROPIC_API_KEY=
