{
  "name": "wikid-api",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:generate:compliance": "prisma generate --config prisma.compliance.config.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:compliance": "prisma migrate dev --config prisma.compliance.config.ts",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:db:push": "prisma db push",
    "prisma:db:push:compliance": "prisma db push --config prisma.compliance.config.ts",
    "prisma:seed": "prisma db seed",
    "start:dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test:e2e": "vitest run --config test/vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.1.3",
    "prisma": "^7.10.1",
    "prosemirror-model": "^1.21.0",
    "puppeteer": "^25.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^8.12.4",
    "y-prosemirror": "^1.2.9",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
