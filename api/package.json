{
  "name": "wikid-api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:generate:compliance": "prisma generate --schema prisma/compliance/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:compliance": "prisma migrate dev --schema prisma/compliance/schema.prisma",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:db:push": "prisma db push",
    "prisma:db:push:compliance": "prisma db push --schema prisma/compliance/schema.prisma",
    "prisma:seed": "prisma db seed",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test:e2e": "vitest run --config test/vitest.config.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-s3": "^3.726.1",
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "@prisma/client": "^5.19.0",
    "jsonwebtoken": "^9.0.2",
    "prosemirror-model": "^1.21.0",
    "puppeteer": "^23.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "y-prosemirror": "^1.2.9",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.13",
    "dotenv": "^16.4.5",
    "prisma": "^5.19.0",
    "prisma-erd-generator": "^2.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
