  "choiceChanges": [
    {
      "name": "a select follows its renamed choice",
      "type": "SELECT",
      "raw": "Open",
      "allowed": [
        "In progress",
        "Done"
      ],
      "renames": [
        [
          "Open",
          "In progress"
        ]
      ],
      "expected": {
        "value": "In progress"
      }
    },
    {
      "name": "a select whose choice went keeps it aside",
      "type": "SELECT",
      "raw": "Done",
      "allowed": [
        "Open"
      ],
      "expected": {
        "kept": "Done"
      }
    },
    {
      "name": "a kept choice comes back",
      "type": "SELECT",
      "kept": "Done",
      "allowed": [
        "Open",
        "Done"
      ],
      "expected": {
        "value": "Done"
      }
    },
    {
      "name": "a kept choice comes back renamed",
      "type": "SELECT",
      "kept": "Done",
      "allowed": [
        "Finished"
      ],
      "renames": [
        [
          "Done",
          "Finished"
        ]
      ],
      "expected": {
        "value": "Finished"
      }
    },
    {
      "name": "a select unchanged",
      "type": "SELECT",
      "raw": "Open",
      "allowed": [
        "Open"
      ],
      "expected": null
    },
    {
      "name": "multi-select: one renamed, one kept",
      "type": "MULTI_SELECT",
      "raw": [
        "Red",
        "Blue"
      ],
      "allowed": [
        "Crimson"
      ],
      "renames": [
        [
          "Red",
          "Crimson"
        ]
      ],
      "expected": {
        "value": [
          "Crimson"
        ],
        "kept": [
          "Blue"
        ]
      }
    },
    {
      "name": "multi-select: all gone",
      "type": "MULTI_SELECT",
      "raw": [
        "Blue"
      ],
      "allowed": [
        "Red"
      ],
      "expected": {
        "kept": [
          "Blue"
        ]
      }
    },
    {
      "name": "multi-select: a kept one back",
      "type": "MULTI_SELECT",
      "raw": [
        "Red"
      ],
      "kept": [
        "Blue"
      ],
      "allowed": [
        "Red",
        "Blue"
      ],
      "expected": {
        "value": [
          "Red",
          "Blue"
        ]
      }
    },
    {
      "name": "multi-select as text",
      "type": "MULTI_SELECT",
      "raw": "a, b",
      "allowed": [
        "a"
      ],
      "expected": {
        "value": [
          "a"
        ],
        "kept": [
          "b"
        ]
      }
    },
    {
      "name": "multi-select unchanged",
      "type": "MULTI_SELECT",
      "raw": [
        "a"
      ],
      "allowed": [
        "a",
        "b"
      ],
      "expected": null
    }
  ]
}
